{
  "compilerOptions": {
    "jsx": "react-native",
    "lib": ["dom", "esnext"],
    "moduleResolution": "node",
    "noEmit": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": true,
    "allowSyntheticDefaultImports": true,
    "target": "esnext",
    "baseUrl": "./",
    "paths": {
      "@assets/*": ["assets/*"],
      "@utils": ["src/utils/index.ts"],
      "@navigations": ["src/navigations/index.ts"],
      "@screens/auth": ["src/screens/auth/index.ts"],
      "@screens/user": ["src/screens/user/index.ts"],
      "@screens/admin": ["src/screens/admin/index.ts"],
      "@components/auth": ["src/components/auth/index.ts"],
      "@components/user": ["src/components/user/index.ts"],
      "@components/admin": ["src/components/admin/index.ts"],
      "@components/shared": ["src/components/shared/index.ts"],
      "@hooks": ["src/hooks/index.ts"],
      "@contexts": ["src/contexts/index.ts"],
      "@firebase/config": ["firebase.config.js"],
      "@firebase/helpers": ["src/firebase/index.ts"]
    }
  },
  "extends": "expo/tsconfig.base"
}
